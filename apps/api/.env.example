# Backend environment, validated at startup by src/config/env.ts.
# Frontend variables live in apps/web/.env.

# development | test | production
NODE_ENV=development
PORT=4000
# MongoDB connection string (required). Include credentials here, never in code.
# Must point at a replica set or Atlas cluster (transactions are used); the docker-compose
# MongoDB is a single-node replica set, reached directly via directConnection=true.
DATABASE_URL=mongodb://localhost:27017/umc?directConnection=true
# How long to wait for MongoDB at startup before giving up (default 10000)
DATABASE_SERVER_SELECTION_TIMEOUT_MS=10000
# Comma-separated list of allowed browser origins (exact origins: scheme + host + optional port,
# no "*", path or trailing slash). Also used to reject cross-site requests to the auth endpoints.
CORS_ORIGIN=http://localhost:5173
# Express "trust proxy": number of reverse proxies in front of the API (default 1), true/false,
# or a list of trusted addresses (e.g. loopback, 10.0.0.0/8). Determines the client IP used for
# rate limiting; set it to match your deployment, or clients can spoof X-Forwarded-For.
TRUST_PROXY=1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Rate limiting (per API process, in memory) ---
# Requests per minute from one IP across the whole API (default 300)
RATE_LIMIT_API_PER_MINUTE=300
# Failed sign-ins per IP per 15 minutes (default 10); per account the limit is 4x per hour
RATE_LIMIT_LOGIN_FAILURES_PER_15_MIN=10

# --- Authentication ---
# Signing secrets for access and refresh JWTs (required, >= 32 chars, must differ).
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_TTL_SECONDS=604800
# bcrypt cost factor, 10-15 (default 12)
BCRYPT_SALT_ROUNDS=12
# SameSite policy of the refresh token cookie: strict | lax | none
# Use "none" only when the web app and API are on different sites (requires HTTPS).
REFRESH_COOKIE_SAME_SITE=strict

# --- File storage ---
# Storage driver: local (an S3-compatible driver can be added later)
STORAGE_DRIVER=local
# Directory for the local driver, relative to the API's working directory (default uploads)
STORAGE_LOCAL_DIR=uploads
# Public base URL of stored files for the local driver; served by the API at /uploads.
# Optional, defaults to http://localhost:<PORT>/uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# --- PDF generation (invoice receipts, rendered with Puppeteer) ---
# Chrome/Chromium binary to use instead of the one Puppeteer downloads on install (optional)
# PDF_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# Disable Chrome's sandbox: true | false (default false). Needed in containers running as root,
# and on Ubuntu 23.10+ unless AppArmor allows Chrome's user namespaces. Only render trusted HTML.
PDF_BROWSER_NO_SANDBOX=false
# Max time for one render step in milliseconds (default 30000)
PDF_RENDER_TIMEOUT_MS=30000
# PDFs rendered at the same time; extra requests wait (default 2, max 16)
PDF_MAX_CONCURRENT_RENDERS=2

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# Provider: disabled | meta (default disabled; sending then fails with WHATSAPP_NOT_CONFIGURED)
WHATSAPP_PROVIDER=disabled
# Required when WHATSAPP_PROVIDER=meta. Use a System User access token with the
# whatsapp_business_messaging permission (Meta Business Settings > System users). Keep it secret.
# WHATSAPP_ACCESS_TOKEN=replace-with-your-meta-system-user-access-token
# Required when WHATSAPP_PROVIDER=meta. The numeric "Phone number ID" from
# WhatsApp Manager > API Setup (not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Graph API version (default v23.0)
WHATSAPP_API_VERSION=v23.0
# Graph API base URL (default https://graph.facebook.com)
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Timeout for each WhatsApp API request in milliseconds (default 15000)
WHATSAPP_REQUEST_TIMEOUT_MS=15000
# Approved message template used to send invoice PDFs (optional). WhatsApp only delivers plain
# documents within 24 hours of the recipient's last message to your number; outside that window
# a template is required. Create a UTILITY template with a DOCUMENT header and a body using
# {{1}} recipient name, {{2}} invoice number, {{3}} amount. Without it, a plain document is sent.
# WHATSAPP_INVOICE_TEMPLATE_NAME=invoice_receipt
# Language the template was approved in (default en)
WHATSAPP_INVOICE_TEMPLATE_LANGUAGE=en
# Delivery-status webhook at <API>/api/webhooks/whatsapp (optional; disabled unless both are set).
# App secret from Meta App Dashboard > App settings > Basic; used to verify webhook signatures.
# WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
# Any random string (>= 16 chars); enter the same value as the "Verify token" in the webhook setup.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-verify-token
