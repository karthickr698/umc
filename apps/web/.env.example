# Frontend environment. Only VITE_-prefixed variables are bundled into client code,
# so never put secrets in them. Backend variables live in apps/api/.env.

# --- Exposed to the browser ---
# Base URL the browser uses for API calls. Leave as /api to go through the Vite dev proxy.
VITE_API_BASE_URL=/api

# --- Vite dev server only (not exposed to the browser) ---
# Where the dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:4000
